# 应用
NODE_ENV=production
PORT=3000
CORS_ORIGIN=*

# 数据库
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=manjie
DB_PASSWORD=manjie_dev_pass
DB_DATABASE=manjie

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# 限流
RATE_LIMIT_GLOBAL=60

# 阿里云 SMS (Phase 2)
# ALIYUN_SMS_ACCESS_KEY=
# ALIYUN_SMS_SECRET=
# ALIYUN_SMS_SIGN=漫界
# ALIYUN_SMS_TEMPLATE=SMS_XXXXX

# 阿里云 OSS (Phase 2)
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=manjie

# Sentry
# SENTRY_DSN=

# Webtoon 对接（免费公开内容）
# WEBTOON_ENABLED=true
# 图片存储目录（必须与 Docker volume 挂载一致）
# WEBTOON_IMAGE_DIR=/data/webtoon-images
# 对外静态 URL 前缀（配合 main.ts useStaticAssets）
# WEBTOON_IMAGE_URL_PREFIX=/static/webtoon
# 图片总配额（GB），超限按 LRU 删除最久未访问章节
# WEBTOON_IMAGE_QUOTA_GB=10
# WebP 质量（82 为画质/体积平衡，章节原图可保持）
# WEBTOON_WEBP_QUALITY=82
# 每日同步时间（cron，默认 03:00）
# WEBTOON_SYNC_GENRES=all,romance,action,comedy,slice_of_life,fantasy
# 抓取间隔（毫秒，礼貌限速）
# WEBTOON_FETCH_INTERVAL_MS=1500
# 若服务器无法直连 webtoons.com，配置 HTTP 代理
# WEBTOON_HTTP_PROXY=http://user:pass@host:port
# 是否只同步免费章节（true=跳过 PAID/PASS）
# WEBTOON_FREE_ONLY=true
# 对外基础地址（拼静态图片绝对 URL）
# PUBLIC_BASE_URL=http://39.106.192.137